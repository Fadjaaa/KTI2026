\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \ab\af0 \ltrch\fcs0 \b\cf1\lang33\langfe1033\langnp33\langfenp1033\insrsid6649900\charrsid6649900 \hich\af0\dbch\af0\loch\f0 1.1\tab}}\pard \ltrpar\ql \fi-360\li360\ri0\sl360\slmult1
